{
  "name": "yuanshu",
  "version": "2.104.0",
  "private": true,
  "description": "元枢个人智能系统 · Web 工作台（SSE 对话与自建引擎）",
  "type": "module",
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "undici": "^7.16.0",
    "ws": "^8.21.3"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.mjs",
    "build:frontend": "npm --prefix frontend run build",
    "version:bump": "node scripts/bump-version.mjs",
    "prune:dist": "node scripts/prune-dist.mjs",
    "sync:frontend": "node scripts/sync-frontend.mjs",
    "build:mobile:web": "npm run build:frontend && npm run sync:frontend",
    "serve:public": "node scripts/serve-public-entries.mjs",
    "sync:persona": "node scripts/sync-persona.mjs",
    "visual:run": "node scripts/visual-engine.mjs"
  },
  "bin": {
    "yuanshu": "bin/pi-web.mjs",
    "yuanshu-agent": "bin/pi-agent.mjs",
    "pi-web": "bin/pi-web.mjs",
    "pi-agent": "bin/pi-agent.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "typescript": "^7.0.2",
    "playwright": "^1.62.1"
  }
