<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-11-23 问小语浮层：盖在当前 App 上的底部卡片，点空白处收起 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/assist_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/assist_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/assist_sheet_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/assist_card_title"
                android:textColor="#F2F5F8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/assist_open_app"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/assist_open_app"
                android:textColor="#A9B1BC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/assist_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="#A9B1BC"
                android:textSize="16sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/assist_reply_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/assist_reply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="#E6EAF0"
                android:textIsSelectable="true"
                android:textSize="15sp" />
        </ScrollView>

        <TextView
            android:id="@+id/assist_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#8A94A1"
            android:textSize="12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/assist_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/assist_input_bg"
            android:gravity="top|start"
            android:hint="@string/assist_hint"
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minLines="2"
            android:padding="12dp"
            android:textColor="#F2F5F8"
            android:textColorHint="#6B7480"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/assist_mic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/assist_mic_bg"
                android:contentDescription="@string/assist_mic"
                android:padding="12dp"
                android:src="@drawable/ic_assist" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/assist_send"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/assist_send_bg"
                android:enabled="false"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="@string/assist_send"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
