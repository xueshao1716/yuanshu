<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-11-23 桌面「问小语」卡片：整块可点，麦克风也是点击区 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_assist_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_assist_bg"
    android:paddingStart="16dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/widget_assist_mic"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_assist"
        android:contentDescription="@string/assist_card_title" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assist_widget_title"
            android:textColor="#F2F5F8"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assist_widget_sub"
            android:textColor="#9AA6B2"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
