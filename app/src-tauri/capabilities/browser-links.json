{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "browser-links",
  "description": "Allow the trusted workbench to open web links in the system browser.",
  "windows": ["main"],
  "local": true,
  "remote": { "urls": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"] },
  "permissions": [{ "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "http://*" }] }]
}
